# Copy to .env. Loaded by the systemd unit.

# Where uploaded files + the metadata database live.
DATA_DIR=/opt/drop/data

# Per-file upload cap in megabytes (mirror in nginx client_max_body_size)
MAX_UPLOAD_MB=200

# Total storage cap across all live files, in gigabytes. Uploads are
# refused once this is reached, protecting your disk.
MAX_TOTAL_GB=5

# Optional: require a key to upload. Leave empty for open uploads.
# Anyone can still DOWNLOAD with a link either way.
#UPLOAD_PASSWORD=pick-something-here

# How often the cleanup job purges expired files (minutes)
CLEANUP_INTERVAL_MIN=10
