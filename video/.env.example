# Copy to .env. Loaded by the systemd unit.

# Required — downloads refuse to run without a key set.
VIDEO_PASSWORD=AndrewYT

# Where downloaded MP4s live until they expire.
DATA_DIR=/opt/video/data

# Longest allowed YouTube video, in minutes.
MAX_YT_MINUTES=60

# How long results stay downloadable, in minutes.
RESULT_TTL_MIN=60

# Hard kill-switch for stuck jobs, in minutes.
JOB_TIMEOUT_MIN=30

# Per-file cap in gigabytes (enforced by yt-dlp during download).
MAX_FILE_GB=2

# Total storage cap for downloaded videos, in gigabytes.
MAX_TOTAL_GB=5
