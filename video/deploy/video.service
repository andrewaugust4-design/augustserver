# Install: sudo cp deploy/video.service /etc/systemd/system/
# Then:    sudo systemctl daemon-reload && sudo systemctl enable --now video

[Unit]
Description=Video YouTube downloader (augustserver.com/video)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/video
EnvironmentFile=/opt/video/.env
ExecStart=/opt/video/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8064 --root-path /video
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/video/data

[Install]
WantedBy=multi-user.target
