# Copy to .env and fill in. The systemd unit loads this file.

# Free key from https://acoustid.org/new-application (register an app, takes ~1 min)
ACOUSTID_API_KEY=

# Whisper model: tiny | base | small | medium | large-v3
# "small" is a good CPU default. "base" is faster / less accurate.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# Upload limit in megabytes
MAX_UPLOAD_MB=100

# Concurrent analyses (keep at 1 on a small CPU server)
ANALYSIS_WORKERS=1

# Optional: path to a custom explicit wordlist (one word per line)
#EXTRA_WORDLIST=/opt/musicreview/extra_words.txt
