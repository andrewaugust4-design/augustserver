# Install: sudo cp deploy/convert.service /etc/systemd/system/
# Then:    sudo systemctl daemon-reload && sudo systemctl enable --now convert

[Unit]
Description=Convert YouTube/media to WAV (augustserver.com/convert)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/convert
EnvironmentFile=/opt/convert/.env
ExecStart=/opt/convert/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8063 --root-path /convert
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/convert/data

[Install]
WantedBy=multi-user.target
