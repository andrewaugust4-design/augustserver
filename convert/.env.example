# Copy to .env. Loaded by the systemd unit.

# Required — conversions refuse to run without a key set.
CONVERT_PASSWORD=AndrewYT

# Where converted WAVs live until they expire.
DATA_DIR=/opt/convert/data

# Per-file upload cap in megabytes (mirror in nginx client_max_body_size)
MAX_UPLOAD_MB=500

# Longest allowed YouTube video, in minutes.
MAX_YT_MINUTES=60

# How long results stay downloadable, in minutes.
RESULT_TTL_MIN=60

# Hard kill-switch for stuck jobs, in minutes.
JOB_TIMEOUT_MIN=30

# Total storage cap for converted files, in gigabytes.
MAX_TOTAL_GB=5
