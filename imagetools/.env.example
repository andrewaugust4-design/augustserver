# Copy to .env. Loaded by the systemd unit.

# Where the U^2-Net model (~170 MB, downloads on first use) is cached.
# Must be writable by www-data — the README setup handles this.
U2NET_HOME=/opt/imagetools/.cache

# rembg model: u2net (default, general purpose) | u2netp (smaller/faster)
# | isnet-general-use (often crisper edges) | u2net_human_seg (people only)
REMBG_MODEL=u2net

# Upload limit in megabytes (mirror in nginx client_max_body_size)
MAX_UPLOAD_MB=25
