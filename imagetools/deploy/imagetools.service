# Install: sudo cp deploy/imagetools.service /etc/systemd/system/
# Then:    sudo systemctl daemon-reload && sudo systemctl enable --now imagetools

[Unit]
Description=Image Tools background remover (augustserver.com/imagetools)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/imagetools
EnvironmentFile=/opt/imagetools/.env
ExecStart=/opt/imagetools/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8061 --root-path /imagetools
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
