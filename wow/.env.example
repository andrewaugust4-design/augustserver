# Copy to .env. The systemd units load this file. No secrets needed — the
# ingest only reads wago.tools' public API/CSV export.

# Override which SQLite file the app reads (defaults to ./data/wow.db
# relative to the repo root; the systemd unit's WorkingDirectory makes that
# /opt/wow/data/wow.db in production).
#WOW_DB_PATH=/opt/wow/data/wow.db
