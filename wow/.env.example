# Copy to .env. The systemd units load this file. Item data needs no
# secrets — the ingest only reads wago.tools' public API/CSV export.

# Override which SQLite file the app reads (defaults to ./data/wow.db
# relative to the repo root; the systemd unit's WorkingDirectory makes that
# /opt/wow/data/wow.db in production).
#WOW_DB_PATH=/opt/wow/data/wow.db

# ── Item icons (optional) ───────────────────────────────────────────────────
# Blizzard Battle.net API client (free, register at https://develop.battle.net).
# Leave unset and the Gear Browser still works, with placeholder icons.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
#BLIZZARD_REGION=us
# Namespace for /data/wow/media/item — defaults to static-classic1x-<region>
# (Classic Era), picked by `python -m ingest.probe_icons`. No Forever
# namespace exists yet; re-run the probe after launch.
#BLIZZARD_ITEM_MEDIA_NAMESPACE=static-classic1x-us
# Where fetched icons (<itemId>.jpg) and the missing-icon cache live.
#WOW_ICON_DIR=/opt/wow/data/icons
